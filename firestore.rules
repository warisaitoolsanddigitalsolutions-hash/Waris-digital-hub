rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == "warisalidigitalsolutions@gmail.com";
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      // Public queries must include status=approved and published=true.
      allow read: if isAdmin() ||
        (signedIn() && resource.data.createdByUid == request.auth.uid) ||
        (resource.data.status == "approved" && resource.data.published == true);

      allow create: if isAdmin() || (
        signedIn() &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.status == "pending" &&
        request.resource.data.published == false &&
        request.resource.data.featured == false &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120
      );

      allow update: if isAdmin() || (
        signedIn() &&
        resource.data.createdByUid == request.auth.uid &&
        request.resource.data.createdByUid == resource.data.createdByUid &&
        request.resource.data.featured == resource.data.featured &&
        request.resource.data.published == false &&
        request.resource.data.status == "pending" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name","cat","price","sale","image","url","buy","affiliate","download",
          "tags","short","full","screenshots","seoTitle","seoDescription","seoKeywords",
          "status","published","updatedAt"
        ])
      );

      allow delete: if isAdmin() || (
        signedIn() && resource.data.createdByUid == request.auth.uid &&
        resource.data.status != "approved"
      );
    }

    match /messages/{messageId} {
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.userEmail == request.auth.token.email;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (
        signedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["userRead"])
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if
        request.resource.data.customer is map &&
        request.resource.data.customer.name is string &&
        request.resource.data.customer.email is string &&
        request.resource.data.items is list &&
        request.resource.data.amount is number &&
        request.resource.data.status == "pending";
      allow read, update, delete: if isAdmin();
    }
  }
}